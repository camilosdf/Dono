# =============================================================================
# Sistema Dono — Variáveis de Ambiente (.env)
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env real no repositório (contém segredos).
#
# ATUALIZAÇÃO (Frente A - Fase 4 e 7):
#   - Adicionadas variáveis para o worker de previsão (FORECAST_*)
#   - Adicionadas variáveis para IA/RAG/OCR (OLLAMA_*, EMBEDDING_MODEL, etc.)
#   - Adicionada variável para intervalo de polling do ai_worker
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SEGREDOS OBRIGATÓRIOS (defina valores fortes e únicos)
# -----------------------------------------------------------------------------

# Senha do usuário "dono" no PostgreSQL.
# Use um valor aleatório forte (ex.: openssl rand -hex 32).
# OBRIGATÓRIO — sem isso o compose falha.
DB_PASSWORD=

# Segredo para assinar/validar os JWTs (HS256).
# Use um valor longo e aleatório (ex.: openssl rand -hex 64).
# OBRIGATÓRIO — sem isso o compose falha.
JWT_SECRET=

# -----------------------------------------------------------------------------
# 2. AMBIENTE E APLICAÇÃO
# -----------------------------------------------------------------------------

# Ambiente da aplicação: production | development
# Padrão: production. O .override.yml sobrescreve para development em dev local.
APP_ENV=production

# -----------------------------------------------------------------------------
# 3. WORKER PRINCIPAL (processa eventos do outbox)
# -----------------------------------------------------------------------------

# Polling de segurança (heartbeat) do worker híbrido LISTEN/NOTIFY.
# Não é mais o mecanismo principal (é o NOTIFY). Serve como fallback.
# Padrão: 300 segundos (5 min).
WORKER_FALLBACK_INTERVAL=300

# -----------------------------------------------------------------------------
# 4. WORKER DE PREVISÃO DE CONSUMO (Fase 4)
# -----------------------------------------------------------------------------

# Intervalo entre execuções do forecast_worker (em horas).
# Padrão: 24 horas (uma vez por dia).
# Para testes, pode reduzir para 1 (usando FORECAST_INTERVAL_HOURS_DEV no override).
FORECAST_INTERVAL_HOURS=24

# Número de dias à frente para gerar previsões.
# Padrão: 30 dias.
FORECAST_DAYS_AHEAD=30

# Quantos dias de histórico usar para calcular a média móvel.
# Padrão: 90 dias.
FORECAST_HISTORICAL_DAYS=90

# (Opcional) Para desenvolvimento: sobrescreve o intervalo para testes mais rápidos.
# Usado no docker-compose.override.yml.
FORECAST_INTERVAL_HOURS_DEV=1

# -----------------------------------------------------------------------------
# 5. WORKER DE IA / RAG / OCR (Fase 7)
# -----------------------------------------------------------------------------

# URL do servidor Ollama (LLM local).
# Padrão: http://ollama:11434 (dentro da rede Docker).
# Para desenvolvimento local com Ollama fora do container, use http://host.docker.internal:11434.
OLLAMA_HOST=http://ollama:11434

# Modelo LLM a ser usado pelo assistente conversacional.
# Exemplos: llama3.1:8b, llama3.2:3b, qwen2.5:7b, phi3:mini, mistral:7b.
# Padrão: llama3.1:8b (requer ~4.7GB de RAM/VRAM).
OLLAMA_MODEL=llama3.1:8b

# Modelo de embedding para RAG (busca semântica).
# Usa sentence-transformers: all-MiniLM-L6-v2 (384 dim) ou all-mpnet-base-v2 (768 dim).
# Padrão: all-MiniLM-L6-v2 (leve, 384 dimensões).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Intervalo de polling do ai_worker (em segundos) para verificar novos jobs.
# Padrão: 5 segundos.
AI_WORKER_POLLING_INTERVAL=5

# (Opcional) Para desenvolvimento: modelo LLM menor para testes rápidos.
# Usado no docker-compose.override.yml.
OLLAMA_MODEL_DEV=llama3.2:3b

# (Opcional) Tamanho do embedding (deve bater com o modelo escolhido).
# 384 para all-MiniLM-L6-v2, 768 para all-mpnet-base-v2.
# Usado internamente pelo código Python; pode ser inferido automaticamente.
# EMBEDDING_DIM=384

# (Opcional) Diretório para cache de modelos do Hugging Face (sentence-transformers).
# Por padrão, usa ~/.cache/huggingface.
# HUGGINGFACE_HUB_CACHE=/app/.cache/huggingface

# -----------------------------------------------------------------------------
# 6. BANCO DE DADOS (já definido via DB_PASSWORD, mas outras variáveis podem ser adicionadas)
# -----------------------------------------------------------------------------

# (Opcional) Pool size do asyncpg.
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10

# (Opcional) Para testes: URL da database de teste (usado pelo pytest).
# Se não definido, o conftest.py tenta substituir /dono por /dono_test.
# TEST_DATABASE_URL=postgresql://dono:${DB_PASSWORD}@db:5432/dono_test

# -----------------------------------------------------------------------------
# 7. REDIS (já configurado via REDIS_URL no compose, mas pode ser sobrescrito)
# -----------------------------------------------------------------------------

# REDIS_URL=redis://redis:6379
# REDIS_PASSWORD= (se houver)

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
# 1. DB_PASSWORD e JWT_SECRET são OBRIGATÓRIOS. O compose falha se não estiverem definidos.
# 2. Para gerar valores seguros:
#      DB_PASSWORD:  openssl rand -hex 32
#      JWT_SECRET:   openssl rand -hex 64
# 3. Se estiver usando Ollama local na máquina host (fora do Docker), ajuste OLLAMA_HOST:
#      Linux/macOS: http://host.docker.internal:11434
#      Windows:     http://host.docker.internal:11434 (se o Docker for Windows)
# 4. Para usar GPU com Ollama, adicione deploy.resources no docker-compose.yml.
# 5. O modelo LLM (OLLAMA_MODEL) será baixado na primeira execução (pode levar minutos).
#    Pré-baixe com: docker compose exec ollama ollama pull <modelo>
# 6. O modelo de embedding (EMBEDDING_MODEL) é baixado automaticamente pelo código Python
#    na primeira execução do ai_worker ou da rota RAG.
# 7. O worker de IA (ai_worker) processa jobs de OCR e gera embeddings para documentos.
#    Certifique-se de que o serviço ollama esteja rodando antes de iniciar o ai_worker.
# 8. Para testes rápidos, use modelos menores (ex.: llama3.2:3b) em desenvolvimento.
# =============================================================================